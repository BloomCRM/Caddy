# =========================================================
# Caddyfile — shared reverse proxy
# Всі домени в одному місці. Caddy сам отримує TLS Let's Encrypt.
#
# Мережа: зовнішня Docker network "web"
# Контейнери: valentyna_app · bloom_api · bloom_admin · bloom_platformadmin
#
# Деплой: docker compose restart caddy  (НЕ down/up — щоб не втратити сертифікати)
# =========================================================

# ── Публічний сайт перукарні ─────────────────────────────────────────────────
valentynah.com, www.valentynah.com {

    @www host www.valentynah.com
    redir @www https://valentynah.com{uri} permanent

    reverse_proxy valentyna_app:8080
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), microphone=(), camera=()"
        -Server
    }

    log {
        output file /data/logs/valentynah.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}

# ── Старі CRM-сабдомени (crm./api./platform.valentynah.com) ПРИБРАНО 29.06.2026 —
#    CRM переїхала на bloomcrm.net (path layout). Сайт valentynah.com лишається вище.

# ── Bloom SaaS — bloomcrm.net (path layout, no subdomains) ───────────────────
bloomcrm.net, www.bloomcrm.net {
    @www host www.bloomcrm.net
    redir @www https://bloomcrm.net{uri} permanent

    handle_path /api/* {
        reverse_proxy bloom_api:8080
    }
    # Bare /app and /platform don't match the /*-wildcard handles → redirect to the slash form.
    handle /app {
        redir * /app/ 308
    }
    handle /platform {
        redir * /platform/ 308
    }
    handle /app/* {
        reverse_proxy bloom_admin:8080
    }
    handle /platform/* {
        reverse_proxy bloom_platformadmin:8080
    }
    handle {
        root * /srv/landing
        file_server
        try_files {path} /index.html
    }

    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    log {
        output file /data/logs/bloomcrm.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}
